NODE_ENV=development
PORT=3333

# Supabase Configuration
# For local development (using `supabase start`), leave SUPABASE_DB_URL empty
# For cloud deployment, set these to your Supabase Cloud values
SUPABASE_DB_URL=postgresql://ibg_api.your-project:change-me@your-pooler-host.supabase.com:6543/postgres
SUPABASE_DB_OWNER_URL=postgresql://postgres:change-me@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_KEY=replace-me

# Database URL for migrations (Supabase Cloud)
# If using Supabase Cloud, set this to your direct connection string
# This overrides SUPABASE_DB_URL for the migration runner
# DATABASE_URL=postgresql://user:password@host:port/database

# Storage & Application
SUPABASE_BUCKET=attachments
APP_BASE_DOMAIN=localhost
CORS_ORIGINS=http://localhost:4200

# Features
WORKER=false

# Skip Migrations (useful for development without local Supabase)
# Uncomment to skip: SKIP_MIGRATIONS=true
